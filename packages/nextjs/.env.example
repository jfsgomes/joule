# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Absolute URL of the RPC proxy. Only needed for a static IPFS export, which
# has no server of its own and must call a hosted origin. Leave empty
# otherwise: scaffold.config.ts defaults to the relative /api/rpc.
NEXT_PUBLIC_RPC_PROXY=

# --- server-side only, never exposed to the browser ---

# Uniswap Trading API key. This powers the buy flow and is the deliverable the
# Uniswap Foundation prize is judged on.
#
# DELIBERATELY NOT PREFIXED WITH NEXT_PUBLIC_. That prefix inlines the value
# into the browser bundle at build time, and both this repository and the
# deployed site are public -- the key would be readable by anyone, and baked
# permanently into any IPFS build.
#
# Read it only from a server-side route handler (app/api/uniswap/*), which adds
# the `x-api-key` header when calling https://trade-api.gateway.uniswap.org/v1.
# The browser calls our route; it never calls Uniswap directly.
#
# Free key from https://hub.uniswap.org/ -- 3 requests/second by default, so
# debounce quote requests and cache them for the ~30s they stay valid.
UNISWAP_API_KEY=

# Alchemy key for the Sepolia RPC, attached server-side by app/api/rpc/route.ts.
#
# ALSO deliberately not NEXT_PUBLIC_. Alchemy can restrict a key by referrer
# instead, but their docs note that a request with no Origin header then fails
# -- and `cast`, `forge` and the delivery agent all send requests without one,
# so restricting the shared key would break deploys and stop the agent
# delivering. Proxying leaves those paths untouched.
#
# The public endpoint is not a substitute: it refuses getLogs beyond ~64 blocks,
# which silently breaks the job ledger.
ALCHEMY_API_KEY=

