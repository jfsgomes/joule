# Copy to agent/.env and fill in. agent/.env is gitignored.

# Local Sepolia fork:  http://127.0.0.1:8545
# Live Sepolia:        https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545

# WorkEscrow address. Printed by DeployWorkEscrow, and readable from
# packages/foundry/deployments/<chainId>.json
ESCROW_ADDRESS=

# MUST be the key of the escrow's `agent` -- submitWork is onlyAgent, and the
# agent refuses to start if this key is anyone else.
#   yarn account:reveal-pk
AGENT_PRIVATE_KEY=

# How far back to scan on startup for jobs missed while the agent was down.
# LOOKBACK_BLOCKS=5000

# ~4s suits both a 12s chain and a local fork.
# POLLING_INTERVAL_MS=4000
